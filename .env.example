# Banco de dados (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth
AUTH_SECRET=                          # gerar: openssl rand -base64 32
AUTH_URL=https://galenusmed.com.br    # URL canônica em produção (http://localhost:3000 em dev)

# Google OAuth (opcional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ETL
ETL_SECRET_KEY=                       # gerar: openssl rand -hex 32

# BNAFAR Open Data API
BNAFAR_API_URL=https://apidadosabertos.saude.gov.br/v1
BNAFAR_API_KEY=                       # opcional — somente se a API exigir chave

# Site
NEXT_PUBLIC_SITE_URL=https://galenusmed.com.br
NEXT_PUBLIC_SITE_NAME=Galenus
